[Unit]
Description=Oria HQ canonical launch consumer
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
User=root
UMask=0077
RuntimeDirectory=oria-hq-control
RuntimeDirectoryMode=0755
# Retain sockets/markers on service stop for explicit reconciliation.
# /run is volatile across reboot; canonical HQ state and persistent attempts remain authoritative.
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /opt/oria-hq-runner/consume_pending.py --config /etc/oria-hq/consumer.json --watch
# Never retry an uncertain launch automatically.
Restart=no
KillMode=mixed
TimeoutStopSec=2100
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/oria-hq/host-config /var/lib/oria-hq/jobs /run/oria-hq-control

[Install]
WantedBy=multi-user.target
