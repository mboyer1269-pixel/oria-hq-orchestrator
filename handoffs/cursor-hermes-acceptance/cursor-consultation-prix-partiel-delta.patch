+function tariffPart(value: number | null): string {
+  return value === null ? "inconnu" : String(value);
+}
+
 function tariffFor(price: CatalogConsultationRow["price"]): string {
   if (price.kind === "unknown") return "inconnu";
   if (price.kind === "proven_zero") return "0 / 0 / 0";
+  if (price.kind === "partial_quote") {
+    return `${tariffPart(price.promptUsdPerMTok)} / ${tariffPart(price.completionUsdPerMTok)} / ${tariffPart(price.perRequestUsd)}`;
+  }
   return `${price.promptUsdPerMTok} / ${price.completionUsdPerMTok} / ${price.perRequestUsd}`;
 }
 
