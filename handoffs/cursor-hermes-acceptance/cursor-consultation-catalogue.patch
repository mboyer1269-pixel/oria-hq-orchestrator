+test("stale free-catalog cache keeps its observation date and is not refreshed", async () => {
+  resetFreeModelCatalogCache();
+  let fetches = 0;
+  const snapshot = loadFreeModelCatalogSnapshot();
+  assert.equal(snapshot.generatedAt, FILE_DATE);
+  assert.ok(snapshot.entries.length > 0);
+  const result = await consult({
+    readCache: undefined,
+    readSecret: () => SECRET,
+    fetch: async () => {
+      fetches += 1;
+      throw new Error("cache must not be refreshed");
+    },
+  });
+  const again = loadFreeModelCatalogSnapshot();
+  assert.equal(fetches, 0);
+  assert.equal(again.generatedAt, FILE_DATE);
+  assert.equal(result.ok, true);
+  assert.equal(result.source, "cache");
+  assert.equal(result.stale, true);
+  assert.equal(result.fetchCount, 0);
+  assert.equal(result.access.public, true);
+  assert.equal(result.access.configured, true);
+  assert.equal(result.access.verified, false);
+  assert.equal(result.access.executionAuthorized, false);
+  assert.equal(result.rows.length, snapshot.entries.length);
+  assert.equal(result.rows[0].modelId, snapshot.entries[0].id);
+  assert.equal(result.rows[0].label, snapshot.entries[0].name);
+  assert.equal(result.rows[0].provider, "openrouter");
+  assert.equal(result.rows[0].observedAt, FILE_DATE);
+  assert.equal(result.rows[0].price.kind, "unknown");
+  assert.equal(result.rows[0].unit, "unknown");
+  assert.deepEqual(result.rows[0].quota, { kind: "unknown" });
+  assert.equal(result.rows[0].unavailableReason, "stale_cache");
+  assert.equal(result.rows[0].executable, false);
+  assert.equal(result.rows.every((row) => row.observedAt === FILE_DATE && row.stale === true), true);
+  assert.equal(JSON.stringify(result).includes(OBSERVED), false);
+  assertDisplaySafe(result);
+
+  const freshAt = new Date(NOW - 1000).toISOString();
+  const fresh = await consult({
+    readCache: () => ({ generatedAt: freshAt, entries: [{ id: "vendor/fresh", name: "Fresh" }] }),
+    fetch: async () => {
+      fetches += 1;
+      throw new Error("fresh cache must not be refreshed");
+    },
+  });
+  assert.equal(fresh.stale, false);
+  assert.equal(fresh.fetchCount, 0);
+  assert.equal(fresh.rows[0].observedAt, freshAt);
+  assert.equal(fresh.rows[0].unavailableReason, "not_executable");
+  assert.equal(fresh.rows[0].executable, false);
+
+  const future = await consult({
+    readCache: () => ({ generatedAt: "2099-01-01T00:00:00.000Z", entries: [{ id: "vendor/future", name: "Future" }] }),
