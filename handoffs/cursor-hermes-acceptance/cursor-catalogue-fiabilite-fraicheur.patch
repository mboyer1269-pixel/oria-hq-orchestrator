 import { join } from "node:path";
 import {
   parseFreeModelCatalog,
@@ -25,10 +25,24 @@ export type FreeModelCatalogSnapshot = {
 };
 
 let cachedSnapshot: FreeModelCatalogSnapshot | null = null;
+let cachedConfigMtimeMs: number | null | undefined;
+
+function configAbsolutePath(): string {
+  return join(process.cwd(), CONFIG_RELATIVE_PATH);
+}
+
+/** Config file mtime for cache invalidation (Market Watch rewrites without clearing module state). */
+export function freeModelCatalogSourceMtimeMs(): number | null {
+  try {
+    return statSync(configAbsolutePath()).mtimeMs;
+  } catch {
+    return null;
+  }
+}
 
 function readSnapshotFromDisk(): FreeModelCatalogSnapshot {
   try {
-    const raw = readFileSync(join(process.cwd(), CONFIG_RELATIVE_PATH), "utf-8");
+    const raw = readFileSync(configAbsolutePath(), "utf-8");
     const withoutBom = raw.charCodeAt(0) === 0xfeff ? raw.slice(1) : raw;
     const json = JSON.parse(withoutBom) as { generated_at?: unknown; provider?: unknown };
     const generatedAt = typeof json.generated_at === "string" ? json.generated_at : null;
@@ -41,8 +55,12 @@ function readSnapshotFromDisk(): FreeModelCatalogSnapshot {
 
 /** Cached snapshot, including the original generated_at. A later read does not refresh that date. */
 export function loadFreeModelCatalogSnapshot(): FreeModelCatalogSnapshot {
-  if (cachedSnapshot) return cachedSnapshot;
+  const mtimeMs = freeModelCatalogSourceMtimeMs();
+  if (cachedSnapshot !== null && cachedConfigMtimeMs === mtimeMs) {
+    return cachedSnapshot;
+  }
   cachedSnapshot = readSnapshotFromDisk();
+  cachedConfigMtimeMs = mtimeMs;
   return cachedSnapshot;
 }
 
@@ -59,4 +77,5 @@ export function readFreeModelCatalog(): FreeModelEntry[] {
 /** Clears the cache (tests / after a Market Watch refresh). */
 export function resetFreeModelCatalogCache(): void {
   cachedSnapshot = null;
+  cachedConfigMtimeMs = undefined;
 }
