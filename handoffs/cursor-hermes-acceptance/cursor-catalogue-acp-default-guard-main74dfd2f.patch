+      if (typeof model !== "string" || model.length === 0 || /\s/.test(model) || !isProviderCatalogModelId(model)) continue;
       const index = observations.findIndex((row) => row.modelId === model);
       if (index < 0) {
         observations.push(blankObservation(model, "public_list", { kind: "unknown" }, announced));
diff --git a/src/server/ai/hq-model-catalog.test.mjs b/src/server/ai/hq-model-catalog.test.mjs
index ef48a02..f7cfb47 100644
--- a/src/server/ai/hq-model-catalog.test.mjs
+++ b/src/server/ai/hq-model-catalog.test.mjs
@@ -372,6 +372,26 @@ test("a public OpenRouter row without request shows the known components and Nar
   assertViewSafe(view);
 });
 
+test("provider catalog rows exclude the ACP profile id default", async () => {
+  const view = await loadHqModelCatalog({
+    nowMs: NOW,
+    authorize: async () => null,
+    readCache: () => null,
+    transport: async (url) => catalogBody(url, [
+      {
+        id: "default",
+        pricing: { prompt: "0.000003", completion: "0.000015", request: "0" },
+      },
+      paidModel("openai/live"),
+    ]),
+  });
+  assert.equal(view.ok, true);
+  assert.equal(view.lines.some((line) => line.modelId === "default"), false);
+  assert.equal(view.lines.some((line) => line.modelId === "openai/live"), true);
+  assert.equal(view.lines.find((line) => line.modelId === "openai/live").tariff, "3 / 15 / 0.002");
+  assertViewSafe(view);
+});
+
 test("a non-zero surcharge stays beside the known tariff and is not labeled free", async () => {
   const view = await loadHqModelCatalog({
