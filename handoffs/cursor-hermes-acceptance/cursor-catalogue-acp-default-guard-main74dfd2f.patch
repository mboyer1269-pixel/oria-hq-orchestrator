From a8ae550f9964981d2634e04c9de87d3848d4f966 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sat, 3 Oct 2026 23:20:39 +0000
Subject: [PATCH] Exclude ACP profile id default from provider catalog rows

Provider catalog ingestion and the OpenRouter free-model cache no longer
surface the ACP session mode id as a tarifiable model.
---
 src/server/ai/gateway-catalog.test.mjs      | 34 +++++++++++++++++++++
 src/server/ai/gateway-catalog.ts            | 11 +++++--
 src/server/ai/hq-model-catalog.test.mjs     | 27 ++++++++++++++++
 src/server/ai/model-catalog-consultation.ts |  5 ++-
 4 files changed, 73 insertions(+), 4 deletions(-)

diff --git a/src/server/ai/gateway-catalog.test.mjs b/src/server/ai/gateway-catalog.test.mjs
index dd612e8..0414284 100644
--- a/src/server/ai/gateway-catalog.test.mjs
+++ b/src/server/ai/gateway-catalog.test.mjs
@@ -524,6 +524,40 @@ test("11 a non-zero per-request fee stays in USD and is not free", async () => {
   noCents(normalized);
 });
 
+test("ACP profile id default is not ingested as a provider catalog row", async () => {
+  const normalized = await normalizeGatewayCatalog(request({
+    fetch: async () => ({
+      status: 200,
+      body: {
+        data: [
+          {
+            id: "default",
+            pricing: { prompt: "0.000003", completion: "0.000015", request: "0" },
+            supported_parameters: ["tools"],
+          },
+          {
+            id: "openai/live",
+            pricing: { prompt: "0.000003", completion: "0.000015", request: "0.002" },
+            supported_parameters: ["tools"],
+          },
+        ],
+      },
+    }),
+  }));
+  assert.equal(normalized.ok, true);
+  assert.equal(normalized.observations.some((row) => row.modelId === "default"), false);
+  assert.equal(normalized.observations.some((row) => row.modelId === "openai/live"), true);
+  const assessed = assessServerEmission({
+    catalog: normalized.catalog,
+    modelId: "default",
+    workspaceId: WORKSPACE,
+    requiresTools: false,
+    nowMs: NOW,
+  });
+  assert.equal(assessed.emit, false);
+  assert.equal(assessed.block, "not_listed");
+});
+
 test("12 an unknown price is not free and is not a capability", async () => {
   const normalized = await normalizeGatewayCatalog(request({
     fetch: async () => ({
