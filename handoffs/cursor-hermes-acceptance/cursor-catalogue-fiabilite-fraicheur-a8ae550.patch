+#!/usr/bin/env node
+
+import assert from "node:assert/strict";
+import { readFileSync, statSync, utimesSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import test, { after } from "node:test";
+import { fileURLToPath } from "node:url";
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const projectRoot = path.resolve(__dirname, "..", "..", "..");
+const configPath = path.join(projectRoot, "config/openrouter.free-models.json");
+
+process.env.NODE_ENV = "test";
+
+const { createJiti } = await import("jiti");
+const jiti = createJiti(import.meta.url, {
+  alias: {
+    "@": path.join(projectRoot, "src"),
+    "server-only": path.join(projectRoot, "src/scripts/smoke/server-only-stub.mjs"),
+  },
+});
+
+const catalogPath = path.join(projectRoot, "src/server/ai/free-model-catalog.ts");
+const {
+  loadFreeModelCatalogSnapshot,
+  resetFreeModelCatalogCache,
+  freeModelCatalogSourceContentSha256,
+} = await jiti.import(catalogPath);
+
+const originalBytes = readFileSync(configPath);
+
+after(() => {
+  writeFileSync(configPath, originalBytes);
+  resetFreeModelCatalogCache();
+});
+
+test("loadFreeModelCatalogSnapshot picks up a rewritten free-model file without resetFreeModelCatalogCache", () => {
+  resetFreeModelCatalogCache();
+  const first = loadFreeModelCatalogSnapshot();
+  assert.ok(first.entries.length > 0);
+
+  writeFileSync(
+    configPath,
+    JSON.stringify(
+      {
+        generated_at: "2026-10-02T00:00:00.000Z",
+        provider: "openrouter",
+        models: [{ id: "test/disk-only", name: "Disk only", enabled: true, recommended: true }],
+      },
+      null,
+      2,
+    ),
+  );
+
+  const second = loadFreeModelCatalogSnapshot();
+  assert.equal(second.entries.some((entry) => entry.id === "test/disk-only"), true);
+  assert.equal(second.generatedAt, "2026-10-02T00:00:00.000Z");
+  assert.notEqual(freeModelCatalogSourceContentSha256(), null);
+});
+
+test("a content rewrite reloads the snapshot even when filesystem mtime is unchanged", () => {
+  resetFreeModelCatalogCache();
+  loadFreeModelCatalogSnapshot();
+  const beforeMtime = statSync(configPath).mtimeMs;
+  const beforeSha = freeModelCatalogSourceContentSha256();
+
+  writeFileSync(
+    configPath,
+    JSON.stringify(
+      {
+        generated_at: "2026-06-12T10:08:29.7657332-04:00",
+        provider: "openrouter",
+        models: [{ id: "test/same-mtime", name: "Same mtime", enabled: true, recommended: true }],
+      },
+      null,
+      2,
+    ),
+  );
+  const mtimeSec = Math.floor(beforeMtime / 1000);
+  utimesSync(configPath, mtimeSec, mtimeSec);
+  assert.equal(Math.floor(statSync(configPath).mtimeMs / 1000), mtimeSec);
+  assert.notEqual(freeModelCatalogSourceContentSha256(), beforeSha);
+
+  const reloaded = loadFreeModelCatalogSnapshot();
+  assert.equal(reloaded.entries.some((entry) => entry.id === "test/same-mtime"), true);
+});
