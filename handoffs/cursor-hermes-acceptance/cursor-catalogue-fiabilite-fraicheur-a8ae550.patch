 import { join } from "node:path";
 import {
   parseFreeModelCatalog,
@@ -25,10 +26,50 @@ export type FreeModelCatalogSnapshot = {
 };
 
 let cachedSnapshot: FreeModelCatalogSnapshot | null = null;
+/**
+ * SHA-256 of on-disk bytes (BOM stripped). Invalidates the in-memory snapshot and
+ * OpenRouter consultation holds when content changes, even if the OS mtime is unchanged.
+ * Limit: a rewrite that is byte-identical after BOM normalization does not invalidate.
+ */
+let cachedSourceContentSha256: string | null | undefined;
+
+function configAbsolutePath(): string {
+  return join(process.cwd(), CONFIG_RELATIVE_PATH);
+}
+
+function readConfigBytes(): Buffer | null {
+  try {
+    return readFileSync(configAbsolutePath());
+  } catch {
+    return null;
+  }
+}
+
+/** Config file mtime (secondary signal; content hash is authoritative for rewrites). */
+export function freeModelCatalogSourceMtimeMs(): number | null {
+  try {
+    return statSync(configAbsolutePath()).mtimeMs;
+  } catch {
+    return null;
+  }
+}
+
+/** SHA-256 of the config file body. Same path as parsing (UTF-8, BOM stripped). */
+export function freeModelCatalogSourceContentSha256(): string | null {
+  const bytes = readConfigBytes();
+  if (bytes === null) return null;
+  const raw = bytes.toString("utf-8");
+  const withoutBom = raw.charCodeAt(0) === 0xfeff ? raw.slice(1) : raw;
+  return createHash("sha256").update(withoutBom, "utf8").digest("hex");
+}
 
 function readSnapshotFromDisk(): FreeModelCatalogSnapshot {
   try {
-    const raw = readFileSync(join(process.cwd(), CONFIG_RELATIVE_PATH), "utf-8");
+    const bytes = readConfigBytes();
+    if (bytes === null) {
+      return { generatedAt: null, provider: null, entries: [] };
+    }
+    const raw = bytes.toString("utf-8");
     const withoutBom = raw.charCodeAt(0) === 0xfeff ? raw.slice(1) : raw;
     const json = JSON.parse(withoutBom) as { generated_at?: unknown; provider?: unknown };
     const generatedAt = typeof json.generated_at === "string" ? json.generated_at : null;
@@ -41,8 +82,12 @@ function readSnapshotFromDisk(): FreeModelCatalogSnapshot {
 
 /** Cached snapshot, including the original generated_at. A later read does not refresh that date. */
 export function loadFreeModelCatalogSnapshot(): FreeModelCatalogSnapshot {
-  if (cachedSnapshot) return cachedSnapshot;
+  const contentSha = freeModelCatalogSourceContentSha256();
+  if (cachedSnapshot !== null && cachedSourceContentSha256 === contentSha) {
+    return cachedSnapshot;
+  }
   cachedSnapshot = readSnapshotFromDisk();
+  cachedSourceContentSha256 = contentSha;
   return cachedSnapshot;
 }
 
@@ -59,4 +104,5 @@ export function readFreeModelCatalog(): FreeModelEntry[] {
 /** Clears the cache (tests / after a Market Watch refresh). */
 export function resetFreeModelCatalogCache(): void {
   cachedSnapshot = null;
+  cachedSourceContentSha256 = undefined;
 }
