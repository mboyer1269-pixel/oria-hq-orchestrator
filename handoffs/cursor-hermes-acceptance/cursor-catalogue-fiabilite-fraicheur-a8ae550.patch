+
+    writeFileSync(
+      freeConfigPath,
+      JSON.stringify(
+        {
+          generated_at: FILE_DATE,
+          provider: "openrouter",
+          models: [{ id: "openrouter/same-mtime-hold", name: "Hold", enabled: true, recommended: true }],
