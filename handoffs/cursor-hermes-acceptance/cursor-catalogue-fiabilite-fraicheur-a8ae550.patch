+test("rewriting the OpenRouter free-model file bypasses a held consultation", async () => {
+  writeFileSync(freeConfigPath, freeConfigOriginal);
+  resetHqModelCatalogHold();
+  resetFreeModelCatalogCache();
+  let openRouterCalls = 0;
+  const authorize = async () => null;
+  globalThis.fetch = async (url, init) => {
+    if (String(url) === OPENROUTER_PUBLIC_MODELS_URL) {
+      openRouterCalls += 1;
+      return new Response(
+        JSON.stringify({ data: [paidModel(`openai/held-${openRouterCalls}`)] }),
+        { status: 200 },
+      );
+    }
+    if (String(url) === NARA_PUBLIC_PLANS_URL) {
+      return new Response(JSON.stringify(naraPlans().body), { status: 200 });
+    }
+    return new Response("no", { status: 404 });
+  };
+  try {
+    const first = await loadHqModelCatalog({ nowMs: NOW, authorize });
+    assert.equal(first.ok, true);
+    assert.equal(openRouterCalls, 1);
+    assert.equal(first.lines.some((line) => line.modelId === "openai/held-1"), true);
+
+    writeFileSync(
+      freeConfigPath,
+      JSON.stringify(
+        {
+          generated_at: FILE_DATE,
+          provider: "openrouter",
+          models: [{ id: "openrouter/file-touch", name: "Touch", enabled: true, recommended: true }],
+        },
+        null,
+        2,
+      ),
+    );
+
+    const second = await loadHqModelCatalog({ nowMs: NOW + 1000, authorize });
+    assert.equal(second.ok, true);
+    assert.equal(openRouterCalls, 2);
+    assert.equal(second.lines.some((line) => line.modelId === "openai/held-2"), true);
+  } finally {
+    globalThis.fetch = async () => {
+      throw new Error("global fetch must not run");
+    };
+  }
+});
+
