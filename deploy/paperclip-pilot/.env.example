# Template only. No working secret and no mutable image tag.
# Both reviewed digest references are literal in compose.json.
# Independent 64-character random hexadecimal values, generated on target.
PILOT_DB_PASSWORD=
PILOT_AUTH_SECRET=
# Open sign-up only during the owner bootstrap through an SSH tunnel.
PILOT_DISABLE_SIGN_UP=true
# Enable only for the initial empty pilot database or separately reviewed upgrade.
PILOT_MIGRATION_AUTO_APPLY=false
