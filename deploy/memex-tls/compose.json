{
  "name": "oria-memex-tls",
  "services": {
    "memex-tls": {
      "image": "oria-memex-tls:reviewed",
      "build": { "context": "." },
      "platform": "linux/amd64",
      "user": "1000:1000",
      "init": true,
      "restart": "no",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "cpus": "0.50",
      "mem_limit": "128m",
      "memswap_limit": "128m",
      "pids_limit": 32,
      "environment": { "NODE_OPTIONS": "--max-old-space-size=64" },
      "secrets": [
        { "source": "tls-key", "target": "tls-key" },
        { "source": "tls-cert", "target": "tls-cert" }
      ],
      "networks": ["bridge-tls", "memory-private"],
      "healthcheck": {
        "test": ["CMD", "node", "-e", "fetch('http://127.0.0.1:3080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"],
        "interval": "15s", "timeout": "3s", "retries": 3
      },
      "logging": { "driver": "json-file", "options": { "max-size": "5m", "max-file": "2" } }
    }
  },
  "networks": {
    "bridge-tls": { "name": "oria-memex-tls-private", "internal": true },
    "memory-private": { "name": "oria-memory-private", "external": true }
  },
  "secrets": {
    "tls-key": { "file": "${MEMEX_TLS_KEY_FILE:?Set external TLS server key file}" },
    "tls-cert": { "file": "${MEMEX_TLS_CERT_FILE:?Set external TLS server certificate file}" }
  }
}
