+// src/server/agents/models/account-identity-binding.ts
+//
+// Opaque, server-side-only surrogate binding from an officially-returned
+// per-USER identifier (e.g. the `email` field of `claude auth status
+// --json`) to a stable `accountId` - never a hash of that identifier.
+//
+// Why not a hash: local-runtime-probe.ts's own classifyClaudeCodeProbe
+// comment (and the independent review that produced it) correctly rules out
+// hashing email for this purpose - email is a low-entropy personal
+// identifier, so a hash of it is reversible by dictionary/rainbow-table,
+// unlike a hash of a high-entropy value. That reasoning is correct FOR A
+// HASH. It does not make every use of an officially-returned user
+// identifier unsafe - only a *reversible* derivation of it. This module
+// uses a different shape entirely: a randomly generated, non-derived
+// accountId (crypto.randomUUID()), looked up through a private server-side
+// store keyed by the real identifier. The identifier itself never leaves
+// this module or its store; only the random accountId propagates upward
+// into evidence, logs, or ProviderConnectionProbeOutcome.accountId.
+//
+// What this module does NOT do:
+//   - Does not read any credential file. The caller is responsible for
+//     obtaining `email` from a real, already-qualified probe
+//     (classifyClaudeCodeProbe's own `claude auth status --json` call) -
+//     this module never touches the filesystem for that.
+//   - Does not enforce OS-level directory protection itself. The injected
+//     store's backing location must already be protected the same way
+//     provider_policy.py's policy registry is (root-owned, no group/other
+//     write bit) - this module composes with that expectation, it does not
+//     re-implement it.
+//   - Does not decide the email-rotation question (what happens if the
+//     same human's email changes) - see the module doc on
+//     resolveOpaqueAccountId below. That is an explicit operator decision,
+//     not something this module assumes.
+
+import { randomUUID } from "node:crypto";
+
+export type AccountIdentityRecord = {
+  email: string;
+  accountId: string;
+  firstObservedAtIso: string;
+};
+
+export type AccountIdentityStore = {
+  findByEmail(email: string): AccountIdentityRecord | undefined;
+  create(record: AccountIdentityRecord): void;
+};
+
+/**
+ * Resolves a stable, opaque accountId for a real, officially-returned
+ * email. The SAME email always resolves to the SAME accountId (looked up
+ * by exact match before creating a new one) - stable across repeated
+ * probes, as model-emission-launch-gate.ts's attestedAccountStillMatches
+ * re-check requires.
+ *
+ * Rotation is intentionally NOT handled: a different email is always a
+ * different accountId, even if it is the same human under a changed
+ * Anthropic account email. This is the deliberately cautious default -
+ * never silently treating two different emails as a continuous identity.
+ * An operator-approved migration path (carrying an old accountId forward
+ * across a known email change) is a separate, explicit decision this
+ * function does not make on its own.
+ *
+ * Never returns or logs the email itself - only ever the accountId.
+ *
+ * The email is normalized (trimmed, lower-cased) BEFORE being used as the
+ * store's lookup/storage key. Caught in independent review before this was
+ * ever wired anywhere: without this, the exact same human's email coming
+ * back with incidental whitespace or different casing across two probes
+ * (plausible across a JSON/CLI round-trip) would silently mint a SECOND,
+ * different accountId for one account - breaking the "same email -> same
+ * accountId" stability model-emission-launch-gate.ts's
+ * attestedAccountStillMatches depends on. The normalized form is also what
+ * gets persisted - never the original, differently-cased input - so every
+ * later lookup for any casing/whitespace variant of the same address
+ * converges on one record.
+ */
+export function resolveOpaqueAccountId(
+  email: string,
+  store: AccountIdentityStore,
+  clock: () => string = () => new Date().toISOString(),
+): string {
+  if (typeof email !== "string" || email.trim() === "") {
+    throw new TypeError("resolveOpaqueAccountId requires a non-empty email");
+  }
+  const normalizedEmail = email.trim().toLowerCase();
+  const existing = store.findByEmail(normalizedEmail);
+  if (existing) return existing.accountId;
+  const accountId = randomUUID();
+  store.create({ email: normalizedEmail, accountId, firstObservedAtIso: clock() });
+  return accountId;
+}
+
+/**
+ * An in-memory store for tests and short-lived callers - never a real
+ * persistence mechanism. A real deployment must inject a store backed by
+ * the same protected-path class as provider_policy.py's policy registry;
+ * none is provided by this module, so a caller cannot reach for a default
+ * that is not actually protected.
+ */
+export function createInMemoryAccountIdentityStore(): AccountIdentityStore {
+  const byEmail = new Map<string, AccountIdentityRecord>();
+  return {
+    findByEmail: (email) => byEmail.get(email),
+    create: (record) => {
+      if (byEmail.has(record.email)) {
+        throw new Error("Duplicate account identity record for the same email");
+      }
+      byEmail.set(record.email, record);
+    },
+  };
+}
