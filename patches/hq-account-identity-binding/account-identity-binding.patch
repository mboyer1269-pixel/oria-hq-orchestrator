+#!/usr/bin/env node
+
+import assert from "node:assert/strict";
+import path from "node:path";
+import test from "node:test";
+import { fileURLToPath } from "node:url";
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const projectRoot = path.resolve(__dirname, "..", "..", "..", "..");
+
+test("Account identity binding tests", async (t) => {
+  const { createJiti } = await import("jiti");
+  const jiti = createJiti(import.meta.url, {
+    alias: {
+      "@": path.join(projectRoot, "src"),
+      "server-only": path.join(projectRoot, "src/scripts/smoke/server-only-stub.mjs"),
+    },
+  });
+
+  const { resolveOpaqueAccountId, createInMemoryAccountIdentityStore } = await jiti.import(
+    "./account-identity-binding",
+    { default: false },
+  );
+
+  await t.test("the same email always resolves to the same accountId", () => {
+    const store = createInMemoryAccountIdentityStore();
+    const first = resolveOpaqueAccountId("person@example.com", store);
+    const second = resolveOpaqueAccountId("person@example.com", store);
+    assert.equal(first, second);
+  });
+
+  await t.test("different emails resolve to different accountIds", () => {
+    const store = createInMemoryAccountIdentityStore();
+    const a = resolveOpaqueAccountId("a@example.com", store);
+    const b = resolveOpaqueAccountId("b@example.com", store);
+    assert.notEqual(a, b);
+  });
+
+  await t.test("accountId is never derived from the email - it is a random UUID, not a hash", async () => {
+    const store = createInMemoryAccountIdentityStore();
+    const email = "person@example.com";
+    const accountId = resolveOpaqueAccountId(email, store);
+    // A hash of a known input is deterministic and reproducible by the
+    // caller; this proves the result is NOT any such reproducible function
+    // of the email by checking it against a few of the most obvious
+    // candidate derivations a reviewer might worry about.
+    const crypto = await import("node:crypto");
+    const sha256 = crypto.createHash("sha256").update(email).digest("hex");
+    assert.notEqual(accountId, sha256);
+    assert.notEqual(accountId, email);
+    assert.match(accountId, /^[0-9a-f-]{36}$/);
+  });
+
+  await t.test("the SAME email resolved against two INDEPENDENT fresh stores produces DIFFERENT accountIds - proving true randomness, not a swappable deterministic derivation", () => {
+    // Review-caught gap: checking accountId !== sha256(email) only rules out
+    // ONE specific deterministic function. A fresh store each time + two
+    // different results for the identical input is what actually proves
+    // resolveOpaqueAccountId is not any reproducible function of the email
+    // at all - swap randomUUID() for ANY deterministic derivation (hash,
+    // HMAC, reshaped hash) and this specific assertion starts failing,
+    // where the sha256-only check would not have caught it.
+    const email = "determinism-check@example.com";
+    const first = resolveOpaqueAccountId(email, createInMemoryAccountIdentityStore());
+    const second = resolveOpaqueAccountId(email, createInMemoryAccountIdentityStore());
+    assert.notEqual(first, second);
+  });
+
+  await t.test("the real email is never present in the returned accountId value", () => {
+    const store = createInMemoryAccountIdentityStore();
+    const email = "distinctive-marker@example.com";
+    const accountId = resolveOpaqueAccountId(email, store);
+    assert.doesNotMatch(accountId, /distinctive-marker/);
+  });
+
+  await t.test("the stored record carries the email, but resolveOpaqueAccountId's return value never does", () => {
+    const store = createInMemoryAccountIdentityStore();
+    const email = "stored@example.com";
+    const accountId = resolveOpaqueAccountId(email, store);
+    const record = store.findByEmail(email);
+    assert.equal(record.email, email);
+    assert.equal(record.accountId, accountId);
+  });
+
+  await t.test("an empty or non-string email is refused, never silently coerced", () => {
+    const store = createInMemoryAccountIdentityStore();
+    assert.throws(() => resolveOpaqueAccountId("", store), TypeError);
+    assert.throws(() => resolveOpaqueAccountId("   ", store), TypeError);
+    assert.throws(() => resolveOpaqueAccountId(undefined, store), TypeError);
+  });
+
+  await t.test("the same email with different casing or incidental whitespace still resolves to the SAME accountId", () => {
+    // Review-caught gap: without normalization, the exact same human's
+    // email coming back differently-cased or whitespace-padded across two
+    // probes would silently mint a second, different accountId - breaking
+    // the one guarantee this module exists to provide.
+    const store = createInMemoryAccountIdentityStore();
+    const canonical = resolveOpaqueAccountId("Person@Example.com", store);
+    const paddedLower = resolveOpaqueAccountId("  person@example.com  ", store);
+    const upper = resolveOpaqueAccountId("PERSON@EXAMPLE.COM", store);
+    assert.equal(canonical, paddedLower);
+    assert.equal(canonical, upper);
+  });
+
+  await t.test("the stored record's email is the normalized form, never the original differently-cased input", () => {
+    const store = createInMemoryAccountIdentityStore();
+    resolveOpaqueAccountId("Person@Example.com", store);
+    const record = store.findByEmail("person@example.com");
+    assert.ok(record, "a lookup by the normalized form must find the record");
+    assert.equal(record.email, "person@example.com");
+  });
+
+  await t.test("firstObservedAtIso comes from the injected clock, never a hidden Date.now()", () => {
+    const store = createInMemoryAccountIdentityStore();
+    const fixedClock = () => "2026-01-01T00:00:00.000Z";
+    resolveOpaqueAccountId("clocked@example.com", store, fixedClock);
+    const record = store.findByEmail("clocked@example.com");
+    assert.equal(record.firstObservedAtIso, "2026-01-01T00:00:00.000Z");
+  });
+
+  await t.test("a direct duplicate create() on the in-memory store refuses rather than overwriting", () => {
+    const store = createInMemoryAccountIdentityStore();
+    store.create({ email: "dup@example.com", accountId: "x", firstObservedAtIso: "2026-01-01T00:00:00.000Z" });
+    assert.throws(() => store.create({ email: "dup@example.com", accountId: "y", firstObservedAtIso: "2026-01-01T00:00:00.000Z" }));
+  });
+});
