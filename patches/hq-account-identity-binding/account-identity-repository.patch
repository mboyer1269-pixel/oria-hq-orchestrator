+++ b/src/server/agents/models/account-identity-repository.test.mjs
@@ -0,0 +1,129 @@
+#!/usr/bin/env node
+
+import assert from "node:assert/strict";
+import path from "node:path";
+import test from "node:test";
+import { fileURLToPath } from "node:url";
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const projectRoot = path.resolve(__dirname, "..", "..", "..", "..");
+
+test("Account Identity Repository (Fallback) tests", async (t) => {
+  const { createJiti } = await import("jiti");
+  const jiti = createJiti(import.meta.url, {
+    alias: {
+      "@": path.join(projectRoot, "src"),
+      "server-only": path.join(projectRoot, "src/scripts/smoke/server-only-stub.mjs"),
+    },
+  });
+
+  // Test relies on natural fallback, same as approval-record-repository.test.mjs:
+  // process.env.NODE_ENV is not "production", so local fallback is allowed.
+  // No Supabase vars are set, so admin client returns null.
+
+  const { resolveOpaqueAccountId, __clearMockAccountIdentities } = await jiti.import(
+    "./account-identity-repository",
+    { default: false },
+  );
+
+  t.afterEach(() => {
+    __clearMockAccountIdentities();
+  });
+
+  const key = (overrides = {}) => ({
+    provider: "claude",
+    workspaceId: "ws-1",
+    email: "person@example.com",
+    ...overrides,
+  });
+
+  await t.test("stable identity: the same (provider, workspaceId, email) always resolves to the same accountId", async () => {
+    const first = await resolveOpaqueAccountId(key());
+    const second = await resolveOpaqueAccountId(key());
+    assert.equal(first, second);
+  });
+
+  await t.test("restart: a fresh lookup for an already-persisted key returns the SAME accountId as the original call, not a new one", async () => {
+    // The fallback array plays the role Supabase would play in production:
+    // a lookup that finds an existing row must return it, never mint a
+    // second accountId for the same key. This is exactly what "surviving a
+    // restart" means for a real, persisted backend - the in-memory
+    // fallback proves the lookup-before-create logic, the same limitation
+    // approval-record-repository.test.mjs already accepts for its own
+    // Supabase-backed repository (no live Supabase in this test environment
+    // either).
+    const original = await resolveOpaqueAccountId(key());
+    const afterSimulatedRestart = await resolveOpaqueAccountId(key());
+    assert.equal(original, afterSimulatedRestart);
+  });
+
+  await t.test("account change: the same email under a DIFFERENT provider resolves to a DIFFERENT accountId", async () => {
+    const claudeId = await resolveOpaqueAccountId(key({ provider: "claude" }));
+    const codexId = await resolveOpaqueAccountId(key({ provider: "codex" }));
+    assert.notEqual(claudeId, codexId);
+  });
+
+  await t.test("account change: the same email under the same provider but a DIFFERENT workspace resolves to a DIFFERENT accountId", async () => {
+    const wsA = await resolveOpaqueAccountId(key({ workspaceId: "ws-a" }));
+    const wsB = await resolveOpaqueAccountId(key({ workspaceId: "ws-b" }));
+    assert.notEqual(wsA, wsB);
+  });
+
+  await t.test("account change: a DIFFERENT email (same provider/workspace) resolves to a DIFFERENT accountId", async () => {
+    const a = await resolveOpaqueAccountId(key({ email: "a@example.com" }));
+    const b = await resolveOpaqueAccountId(key({ email: "b@example.com" }));
+    assert.notEqual(a, b);
+  });
+
+  await t.test("unknown refusal: an empty or non-string provider/workspaceId/email is refused, never silently coerced", async () => {
+    await assert.rejects(() => resolveOpaqueAccountId(key({ provider: "" })), TypeError);
+    await assert.rejects(() => resolveOpaqueAccountId(key({ workspaceId: "   " })), TypeError);
+    await assert.rejects(() => resolveOpaqueAccountId(key({ email: undefined })), TypeError);
+  });
+
+  await t.test("accountId is never derived from the email - it is a random UUID, not a hash", async () => {
+    const accountId = await resolveOpaqueAccountId(key());
+    const crypto = await import("node:crypto");
+    const sha256 = crypto.createHash("sha256").update("person@example.com").digest("hex");
+    assert.notEqual(accountId, sha256);
+    assert.notEqual(accountId, "person@example.com");
+    assert.match(accountId, /^[0-9a-f-]{36}$/);
+  });
+
+  await t.test("the real email is never present in the returned accountId value", async () => {
+    const accountId = await resolveOpaqueAccountId(key({ email: "distinctive-marker@example.com" }));
+    assert.doesNotMatch(accountId, /distinctive-marker/);
+  });
+
+  await t.test("the same email with different casing or incidental whitespace still resolves to the SAME accountId", async () => {
+    const canonical = await resolveOpaqueAccountId(key({ email: "Person@Example.com" }));
+    const paddedLower = await resolveOpaqueAccountId(key({ email: "  person@example.com  " }));
+    const upper = await resolveOpaqueAccountId(key({ email: "PERSON@EXAMPLE.COM" }));
+    assert.equal(canonical, paddedLower);
+    assert.equal(canonical, upper);
+  });
+
+  await t.test("createdAt comes from the injected clock, never a hidden Date.now()", async () => {
+    const fixedClock = () => "2026-01-01T00:00:00.000Z";
+    const id1 = await resolveOpaqueAccountId(key(), fixedClock);
+    const id2 = await resolveOpaqueAccountId(key(), fixedClock);
+    assert.equal(id1, id2);
+  });
+
+  await t.test("production never silently uses the local fallback", async () => {
+    // Mirrors approval-record-repository.test.mjs's own production test
+    // exactly: in production, with no Supabase admin client configured,
+    // the repository must FAIL CLOSED rather than silently persisting to
+    // (or reading from) the in-memory mock.
+    const previousNodeEnv = process.env.NODE_ENV;
+    try {
+      process.env.NODE_ENV = "production";
+      await assert.rejects(
+        () => resolveOpaqueAccountId(key({ email: "prod-check@example.com" })),
+        /Supabase configuration is required for account identity persistence in production/,
+      );
+    } finally {
+      process.env.NODE_ENV = previousNodeEnv;
+    }
+  });
+});
