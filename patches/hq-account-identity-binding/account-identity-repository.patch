@@ -0,0 +1,152 @@
+// src/server/agents/models/account-identity-repository.ts
+//
+// Persistent, opaque, server-side-only surrogate binding from an
+// officially-returned per-USER identifier (e.g. the `email` field of
+// `claude auth status --json`) to a stable `accountId` - never a hash of
+// that identifier.
+//
+// This supersedes the in-memory-only account-identity-binding.ts helper:
+// that module was correctly flagged in review as "not an operational
+// connection/binding" - stable only within one process's lifetime, useless
+// across a restart. This file reuses the EXACT existing persistence
+// pattern already trusted elsewhere in this codebase
+// (approval-record-repository.ts's insertMissionApprovalRecord/
+// getMissionApprovalRecord: a real Supabase-backed table in production,
+// with an explicitly gated in-memory fallback for local development that
+// fails closed in production rather than silently persisting nowhere) -
+// never a new, separately-invented storage mechanism.
+//
+// Why not a hash: a hash of email is reversible by dictionary/rainbow-
+// table (email is a low-entropy personal identifier), unlike a hash of a
+// high-entropy value. That rules out a HASH specifically, not every use of
+// an officially-returned identifier. This module uses a different shape
+// entirely: a randomly generated, non-derived accountId
+// (crypto.randomUUID()), looked up through this private, protected table
+// by the real identifier. The identifier itself never leaves this module;
+// only the random accountId propagates upward.
+//
+// Key shape: (provider, workspaceId, email) - never email alone. The same
+// email string can legitimately belong to different accounts under
+// different providers (e.g. a Claude login and a separate Codex login
+// sharing one human's personal email address) or under different HQ
+// workspaces; email alone as the key would silently MERGE those into one
+// accountId - exactly the cross-account conflation this module exists to
+// prevent.
+//
+// What this module does NOT do:
+//   - Does not read any credential file. The caller is responsible for
+//     obtaining `email` from a real, already-qualified probe
+//     (classifyClaudeCodeProbe's own `claude auth status --json` call).
+//   - Does not create the `account_identities` table itself - that is a
+//     database migration, a separate deployment step, exactly like
+//     `mission_approvals`'s own table is not created by
+//     approval-record-repository.ts either.
+//   - Does not decide the email-rotation question (what happens if the
+//     same human's email changes across two probes) - a different email
+//     is always a different accountId here, deliberately, never a
+//     silently continued identity.
+//   - Does not call, activate, or reach any model/provider API. Pure data
+//     persistence only.
+
+import { isLocalPersistenceFallbackAllowed } from "@/lib/server-env";
+import { createOptionalSupabaseAdminClient } from "@/server/supabase/admin";
+import { randomUUID } from "node:crypto";
+
+export type AccountIdentityKey = {
+  provider: string;
+  workspaceId: string;
+  email: string;
+};
+
+type StoredAccountIdentity = AccountIdentityKey & {
+  accountId: string;
+  createdAt: string;
+};
+
+// In-memory fallback array for local development without Supabase - same
+// shape and same guard (isLocalPersistenceFallbackAllowed) as
+// approval-record-repository.ts's mockApprovalRecords.
+const mockAccountIdentities: StoredAccountIdentity[] = [];
+
+function normalizeKey(key: AccountIdentityKey): AccountIdentityKey {
+  const provider = typeof key.provider === "string" ? key.provider.trim() : "";
+  const workspaceId = typeof key.workspaceId === "string" ? key.workspaceId.trim() : "";
+  const email = typeof key.email === "string" ? key.email.trim().toLowerCase() : "";
+  if (!provider) throw new TypeError("resolveOpaqueAccountId requires a non-empty provider");
+  if (!workspaceId) throw new TypeError("resolveOpaqueAccountId requires a non-empty workspaceId");
+  if (!email) throw new TypeError("resolveOpaqueAccountId requires a non-empty email");
+  return { provider, workspaceId, email };
+}
+
+/**
+ * Resolves a stable, opaque accountId for a real, officially-returned
+ * (provider, workspaceId, email) triple - persisted for real (Supabase in
+ * production; a gated in-memory fallback, same as every other repository
+ * in this codebase, for local development only). The SAME triple always
+ * resolves to the SAME accountId across calls, including across a process
+ * restart when backed by Supabase. A DIFFERENT provider or workspace with
+ * the SAME email resolves to a DIFFERENT accountId.
+ *
+ * Never returns or logs the email itself - only ever the accountId.
+ */
+export async function resolveOpaqueAccountId(
+  key: AccountIdentityKey,
+  clock: () => string = () => new Date().toISOString(),
+): Promise<string> {
+  const normalized = normalizeKey(key);
+  const supabase = createOptionalSupabaseAdminClient();
+
+  if (supabase) {
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const { data, error } = await (supabase.from("account_identities") as any)
+      .select()
+      .eq("provider", normalized.provider)
+      .eq("workspace_id", normalized.workspaceId)
+      .eq("email", normalized.email)
+      .limit(1)
+      .maybeSingle();
+
+    if (error) {
+      throw new Error(`Failed to query account_identities from Supabase: ${error.message}`);
+    }
+    if (data) return data.account_id as string;
+
+    const accountId = randomUUID();
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const { error: insertError } = await (supabase.from("account_identities") as any).insert({
+      account_id: accountId,
+      provider: normalized.provider,
+      workspace_id: normalized.workspaceId,
+      email: normalized.email,
+      created_at: clock(),
+    });
+    if (insertError) {
+      throw new Error(`Failed to insert account_identities into Supabase: ${insertError.message}`);
+    }
+    return accountId;
+  }
+
+  if (!isLocalPersistenceFallbackAllowed()) {
+    throw new Error("Supabase configuration is required for account identity persistence in production.");
+  }
+
+  const existing = mockAccountIdentities.find(
+    (record) =>
+      record.provider === normalized.provider &&
+      record.workspaceId === normalized.workspaceId &&
+      record.email === normalized.email,
+  );
+  if (existing) return existing.accountId;
+
+  const accountId = randomUUID();
+  mockAccountIdentities.push({ ...normalized, accountId, createdAt: clock() });
+  return accountId;
+}
+
+/**
+ * Used purely for testing the fallback repository - same convention as
+ * approval-record-repository.ts's __clearMockApprovalRecords.
+ */
+export function __clearMockAccountIdentities(): void {
+  mockAccountIdentities.length = 0;
+}
